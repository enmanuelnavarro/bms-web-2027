# Plantilla de variables de entorno. Copiar a .env.local y rellenar.
#
#   cp .env.example .env.local
#
# .env.local NO se sube a git (lleva secretos). Este archivo sí, para que la
# estructura no viva solo en un portátil. Nunca pongas aquí valores reales de
# claves ni tokens.

# ── Secretos (sin prefijo NEXT_PUBLIC_: solo se leen en el servidor) ────────

# Resend, para el formulario de contacto. Se obtiene en https://resend.com
RESEND_API_KEY=

# Instagram Graph API, para el feed en directo de la home.
# Cuenta Business/Creator + app en developers.facebook.com. Caduca a los 60
# días. Ver la sección "FEED DE INSTAGRAM" del README.
INSTAGRAM_ACCESS_TOKEN=
# Opcional: id numérico de la cuenta. Vacío = "me".
INSTAGRAM_USER_ID=

# ── Públicos (se incrustan en el JavaScript del navegador) ─────────────────

# Widget de Instagram de terceros. Plan B: solo se usa si no hay token de Meta.
NEXT_PUBLIC_IG_WIDGET_SRC=
NEXT_PUBLIC_IG_WIDGET_HTML=

# Correos de contacto
NEXT_PUBLIC_CONTACT_EMAIL=players@bmsrd.com
NEXT_PUBLIC_INFO_EMAIL=info@bmsrd.com

# Oficinas
NEXT_PUBLIC_OFFICE_RD_ADDRESS="La Vega, Rep. Dom."
NEXT_PUBLIC_OFFICE_RD_PHONE="+1-809-781-5605"
NEXT_PUBLIC_OFFICE_MIAMI_ADDRESS="55 NE 5th St, Miami, FL 33132, USA"
NEXT_PUBLIC_OFFICE_MIAMI_PHONE="+1-305-926-4480"
NEXT_PUBLIC_WHATSAPP_NUMBER="+1-809-781-5605"

# Redes sociales (comprobadas una a una)
NEXT_PUBLIC_FACEBOOK="https://www.facebook.com/BASKETMANAGEMENTSOLUTIONS"
NEXT_PUBLIC_INSTAGRAM="https://www.instagram.com/bmsrdagency"
NEXT_PUBLIC_TWITTER="https://x.com/bmsrdagency"
NEXT_PUBLIC_YOUTUBE="https://www.youtube.com/@bmsagencyrd"

# ── Panel de administración (/admin) ───────────────────────────────────────

# Base de datos Postgres. En Vercel: Storage → crear base de datos (Neon) → la
# variable se inyecta sola en el despliegue. En local se copia aquí a mano,
# desde esa misma pantalla, pestaña ".env.local".
DATABASE_URL=

# Almacén de imágenes. En Vercel: Storage → crear un Blob store. Igual que la
# anterior: en producción se inyecta sola, en local se copia.
BLOB_READ_WRITE_TOKEN=

# Firma de la cookie de sesión del panel. Mínimo 32 caracteres. Sin esto el
# panel no deja entrar a nadie: falla cerrando.
#   Genera uno con:  openssl rand -base64 48
# Si se cambia, todas las sesiones abiertas caducan de golpe.
ADMIN_SESSION_SECRET=

# ── Web en obras ───────────────────────────────────────────────────────────
# Con esta variable puesta, la web queda cerrada al público: se enseña
# /en-construccion y solo se entra con esta clave. Para abrir la web al
# público, borrar la variable (aquí y en Vercel). Ver lib/acceso.ts.
SITE_PASSWORD=
