# Nunca enviar secretos ni artefactos locales a Vercel.
# Las variables de entorno se configuran en el panel de Vercel, no por archivo.
.env
.env*.local
.next
node_modules
.DS_Store
.claude

# Los originales de las fotos solo hacen falta para volver a generar
# /public/players con scripts/normaliza-fotos.mjs. 19 MB que Vercel no necesita.
assets
